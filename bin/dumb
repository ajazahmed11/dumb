#!/usr/bin/env bash
# ==============================================================================
# DUMB — DUMB's Universal Migration & Backup
# A zero-bloat, distro-agnostic workstation migration framework.
# ==============================================================================

set -eo pipefail

VERSION="0.8.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

CONFIG_FILE="${PROJECT_ROOT}/config/layers.conf"
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

REMOTE="${DUMB_REMOTE:-gdrive:DUMB-Vault}"
DATE=$(date +%Y-%m-%d)
TRASH="${REMOTE}/Old-Versions/${DATE}"
BROWSER_PRESET="${DUMB_BROWSER_PRESET:-firefox}"
HARDWARE_PRESET="${DUMB_HARDWARE_PRESET:-asus-rog}"
IS_DRY_RUN="false"
DRY_FLAG=""

# Default Master Layer Registry if undefined in config
if [ -z "${AVAILABLE_LAYERS+x}" ] || [ ${#AVAILABLE_LAYERS[@]} -eq 0 ]; then
    AVAILABLE_LAYERS=(
        "1|Personal Files|Documents, Projects, Pictures, etc."
        "2|Application Configurations|Clean ~/.config (excluding cache bloat)"
        "3|Browser Session Vault|Persistent logins and session cookies"
        "4|Home Dotfiles & Scripts|Tracked dotfiles and ~/.local/bin scripts"
        "5|AI Agent Vault|All configured AI agent memories and brain contexts"
        "6|Hardware Blueprint & Fonts|Fan curves, system services, and fonts"
    )
fi

get_layer_name() {
    local target_id="$1"
    for entry in "${AVAILABLE_LAYERS[@]}"; do
        local id="${entry%%|*}"
        if [ "$id" = "$target_id" ]; then
            local rest="${entry#*|}"
            echo "${rest%%|*}"
            return 0
        fi
    done
    echo "Layer ${target_id}"
}

get_layer_desc() {
    local target_id="$1"
    for entry in "${AVAILABLE_LAYERS[@]}"; do
        local id="${entry%%|*}"
        if [ "$id" = "$target_id" ]; then
            echo "${entry##*|}"
            return 0
        fi
    done
    echo ""
}

# Default fallback for Layer 4 dotfiles if undefined in config
if [ -z "${DOTFILES+x}" ] || [ ${#DOTFILES[@]} -eq 0 ]; then
    DOTFILES=(
        "$HOME/.bashrc"
        "$HOME/.gitconfig"
        "$HOME/.profile"
        "$HOME/.zshrc"
    )
fi

# Detect available engines
RCLONE_CMD="$(command -v rclone 2>/dev/null || echo "$HOME/.local/bin/rclone")"
RSYNC_CMD="$(command -v rsync 2>/dev/null || echo "")"

notify_user() {
    local title="$1"
    local msg="$2"
    if command -v notify-send &>/dev/null; then
        notify-send -a "DUMB" -i dialog-information "$title" "$msg" 2>/dev/null || true
    fi
}

detect_engine() {
    local target="$1"
    if [[ "$target" =~ ^[a-zA-Z0-9_-]+: ]]; then
        echo "rclone"
    else
        echo "rsync"
    fi
}

print_banner() {
    local active_engine
    active_engine="$(detect_engine "$REMOTE")"
    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${BLUE}  🥱 DUMB — DUMB's Universal Migration & Backup     ${NC}"
    echo -e "${BLUE}  Version:   v${VERSION}                                  ${NC}"
    echo -e "${BLUE}  Target:    ${REMOTE}                             ${NC}"
    echo -e "${BLUE}  Engine:    ${active_engine} (Auto-detected)             ${NC}"
    echo -e "${BLUE}  Safety:    ${TRASH}                             ${NC}"
    echo -e "${BLUE}  Browser:   ${BROWSER_PRESET}                    ${NC}"
    echo -e "${BLUE}  Hardware:  ${HARDWARE_PRESET}                   ${NC}"
    echo -e "${BLUE}=====================================================${NC}"
}

usage() {
    echo -e "Usage: dumb [COMMAND] [OPTIONS]\n"
    echo -e "Commands:"
    echo -e "  backup [OPTIONS]     Run workstation backup (all layers or selective -l)"
    echo -e "  restore [OPTIONS]    Restore selected layers onto this workstation"
    echo -e "  bundle [FILE.tar.zst] Pack entire clean workstation into a single pendrive archive"
    echo -e "  unbundle <ARCHIVE>   Restore from a single pendrive archive"
    echo -e "  explain              Show exact WHAT, WHERE, and HOW breakdown of this system"
    echo -e "  inspect              Scan and calculate disposable cache bloat eliminated"
    echo -e "  init                 Guided setup wizard with auto-detection for USB/Cloud/Folders"
    echo -e "  check [OPTIONS]      Dry-run inspection of what would be backed up"
    echo -e "  status               Show current backup configuration and target state"
    echo -e "  version              Print DUMB version"
    echo -e "  help                 Display this help message\n"
    echo -e "Options:"
    echo -e "  -r, --remote <dest>  Override target remote, local folder, or USB path"
    echo -e "  -l, --layers <list>  Comma-separated layers to backup/restore (1-6 or A)"
    echo -e "  -n, --dry-run        Simulate restore/backup without writing any files"
    echo -e "  -h, --help           Show help\n"
    echo -e "Target Examples:"
    echo -e "  dumb backup -r /run/media/$USER/PENDRIVE/DUMB-Vault   # USB Pendrive / Flash Drive"
    echo -e "  dumb backup -r $HOME/Nextcloud/DUMB-Vault             # Nextcloud / Dropbox"
    echo -e "  dumb backup -r gdrive:DUMB-Vault                     # Google Drive (rclone)"
    echo -e "  dumb backup -l 1,4                                   # Fast selective backup"
    echo -e "  dumb restore -n --layers 1,3,4                       # Safe restore dry-run"
    exit 0
}

# Unified Transport Helpers
dumb_sync() {
    local src="$1"
    local dst="$2"
    local trash="$3"
    shift 3
    local excludes=("$@")

    local engine
    engine="$(detect_engine "$dst")"

    if [ "$engine" = "rclone" ]; then
        local exc_args=()
        for exc in "${excludes[@]}"; do
            exc_args+=(--exclude "$exc")
        done
        "$RCLONE_CMD" sync "$src" "$dst" --backup-dir "$trash" "${exc_args[@]}" --fast-list --links $DRY_FLAG
    else
        if [ -z "$RSYNC_CMD" ]; then
            echo -e "${RED}Error: rsync is required for local/pendrive sync but not found.${NC}"
            exit 1
        fi
        mkdir -p "$dst" "$trash"
        local exc_args=()
        for exc in "${excludes[@]}"; do
            exc_args+=(--exclude="$exc")
        done
        local rsync_dry=""
        [ "$IS_DRY_RUN" = "true" ] && rsync_dry="-n"
        "$RSYNC_CMD" -a --delete --backup --backup-dir="$trash" "${exc_args[@]}" "$src/" "$dst/" $rsync_dry
    fi
}

dumb_copy() {
    local src="$1"
    local dst="$2"
    local engine
    engine="$(detect_engine "$dst")"

    if [ "$engine" = "rclone" ]; then
        "$RCLONE_CMD" copy "$src" "$dst" $DRY_FLAG
    else
        if [ -z "$RSYNC_CMD" ]; then
            echo -e "${RED}Error: rsync is required for local copying.${NC}"
            exit 1
        fi
        mkdir -p "$dst"
        local rsync_dry=""
        [ "$IS_DRY_RUN" = "true" ] && rsync_dry="-n"
        "$RSYNC_CMD" -a "$src" "$dst/" $rsync_dry
    fi
}

restore_copy() {
    local src="$1"
    local dst="$2"
    if [ "$IS_DRY_RUN" = "true" ]; then
        echo -e "   ${YELLOW}[DRY-RUN] Would restore:${NC} $src -> $dst"
        return 0
    fi
    local active_engine
    active_engine="$(detect_engine "$REMOTE")"
    if [ "$active_engine" = "rclone" ]; then
        "$RCLONE_CMD" copy "$src" "$dst" --fast-list 2>/dev/null || true
    else
        mkdir -p "$dst"
        "$RSYNC_CMD" -a "$src/" "$dst/" 2>/dev/null || true
    fi
}

restore_file() {
    local src="$1"
    local dst="$2"
    if [ "$IS_DRY_RUN" = "true" ]; then
        echo -e "   ${YELLOW}[DRY-RUN] Would restore file:${NC} $src -> $dst"
        return 0
    fi
    mkdir -p "$(dirname "$dst")"
    local active_engine
    active_engine="$(detect_engine "$REMOTE")"
    if [ "$active_engine" = "rclone" ]; then
        "$RCLONE_CMD" copyto "$src" "$dst" 2>/dev/null || true
    else
        if [ -f "$src" ]; then
            "$RSYNC_CMD" -a "$src" "$dst" 2>/dev/null || true
        fi
    fi
}

# ------------------------------------------------------------------------------
# Modular Layer Handlers (Layers 1-6)
# ------------------------------------------------------------------------------

# Layer 1: Personal Files
explain_layer_1() {
    for p in "${PERSONAL_DIRS[@]}"; do
        local p_exp="${p/#\~/$HOME}"
        [ -d "$p_exp" ] && echo "     - $p_exp (Excludes: node_modules, .venv, build, __pycache__)"
    done
}
backup_layer_1() {
    for pdir in "${PERSONAL_DIRS[@]}"; do
        local pdir_exp="${pdir/#\~/$HOME}"
        if [ -d "$pdir_exp" ]; then
            local bname
            bname="$(basename "$pdir_exp")"
            echo "   • Syncing: $pdir_exp -> ${REMOTE}/01-Personal-Files/${bname}"
            dumb_sync "$pdir_exp" "${REMOTE}/01-Personal-Files/${bname}" \
                "${TRASH}/01-Personal-Files/${bname}" "${EXCLUDE_PERSONAL[@]}"
        fi
    done
}
restore_layer_1() {
    for pdir in "${PERSONAL_DIRS[@]}"; do
        local pdir_exp="${pdir/#\~/$HOME}"
        local bname
        bname="$(basename "$pdir_exp")"
        restore_copy "${REMOTE}/01-Personal-Files/${bname}" "$pdir_exp"
    done
}

# Layer 2: Clean App Configurations (~/.config)
explain_layer_2() {
    echo "     - $HOME/.config (Excludes: GPUCache, blob_storage, sockets, locks)"
}
backup_layer_2() {
    if [ -d "$HOME/.config" ]; then
        dumb_sync "$HOME/.config" "${REMOTE}/02-dot-config" \
            "${TRASH}/02-dot-config" "${EXCLUDE_CONFIG[@]}"
    fi
}
restore_layer_2() {
    restore_copy "${REMOTE}/02-dot-config" "$HOME/.config"
}

# Layer 3: Browser Session Vault
explain_layer_3() {
    echo "     - Preset '${BROWSER_PRESET}' (Preserves cookies & logins, strips disposable cache2/)"
}
backup_layer_3() {
    local browser_preset_file="${PROJECT_ROOT}/presets/browsers/${BROWSER_PRESET}.conf"
    if [ "$BROWSER_PRESET" != "none" ] && [ -f "$browser_preset_file" ]; then
        # shellcheck source=/dev/null
        source "$browser_preset_file"
        local found_browser=""
        for b_path in "${BROWSER_PATHS[@]}"; do
            b_path="${b_path/#\~/$HOME}"
            if [ -d "$b_path" ]; then
                found_browser="$b_path"
                break
            fi
        done
        if [ -n "$found_browser" ]; then
            echo "   • Syncing Browser [${BROWSER_NAME}]: $found_browser"
            dumb_sync "$found_browser" "${REMOTE}/03-Browser-Vault" \
                "${TRASH}/03-Browser-Vault" "${BROWSER_EXCLUDES[@]}"
        else
            echo "   No active profile directory found for ${BROWSER_NAME}. Skipping."
        fi
    else
        echo "   Browser preset set to 'none' or preset file missing. Skipping."
    fi
}
restore_layer_3() {
    local browser_preset_file="${PROJECT_ROOT}/presets/browsers/${BROWSER_PRESET}.conf"
    if [ -f "$browser_preset_file" ]; then
        # shellcheck source=/dev/null
        source "$browser_preset_file"
        local dest_path="${BROWSER_PATHS[0]}"
        dest_path="${dest_path/#\~/$HOME}"
        mkdir -p "$dest_path"
        restore_copy "${REMOTE}/03-Browser-Vault" "$dest_path"
        echo "   Logins and cookies target: $dest_path"
    fi
}

# Layer 4: Home Dotfiles & Custom Scripts
explain_layer_4() {
    echo "     - Tracked dotfiles:"
    for df in "${DOTFILES[@]}"; do
        local df_exp="${df/#\~/$HOME}"
        [ -f "$df_exp" ] && echo "       • $df_exp"
    done
    [ -d "$HOME/.local/bin" ] && echo "     - Custom user scripts: $HOME/.local/bin"
}
backup_layer_4() {
    for df in "${DOTFILES[@]}"; do
        local df_exp="${df/#\~/$HOME}"
        if [ -f "$df_exp" ]; then
            echo "   • Syncing dotfile: $df_exp"
            dumb_copy "$df_exp" "${REMOTE}/04-Home-Dotfiles/"
        fi
    done
    if [ -d "$HOME/.local/bin" ]; then
        dumb_sync "$HOME/.local/bin" "${REMOTE}/04-Home-Dotfiles/local-bin" \
            "${TRASH}/04-Home-Dotfiles/local-bin" "agy" "rclone"
    fi
}
restore_layer_4() {
    for df in "${DOTFILES[@]}"; do
        local df_exp="${df/#\~/$HOME}"
        local bname
        bname="$(basename "$df_exp")"
        restore_file "${REMOTE}/04-Home-Dotfiles/${bname}" "$df_exp"
    done
    mkdir -p "$HOME/.local/bin"
    restore_copy "${REMOTE}/04-Home-Dotfiles/local-bin" "$HOME/.local/bin"
}

# Layer 5: AI Agent Vault
explain_layer_5() {
    for a in "${AI_AGENT_DIRS[@]}"; do
        local aname="${a%%:*}"
        local apath="${a#*:}"
        apath="${apath/#\~/$HOME}"
        [ -d "$apath" ] && echo "     - $aname ($apath)"
    done
}
backup_layer_5() {
    for agent_entry in "${AI_AGENT_DIRS[@]}"; do
        local agent_name="${agent_entry%%:*}"
        local agent_path="${agent_entry#*:}"
        agent_path="${agent_path/#\~/$HOME}"
        if [ -d "$agent_path" ]; then
            echo "   • Syncing AI Agent [${agent_name}]: $agent_path"
            dumb_sync "$agent_path" "${REMOTE}/05-AI-Agent-Vault/${agent_name}" \
                "${TRASH}/05-AI-Agent-Vault/${agent_name}" "${EXCLUDE_AI_AGENTS[@]}"
        fi
    done
}
restore_layer_5() {
    for agent_entry in "${AI_AGENT_DIRS[@]}"; do
        local agent_name="${agent_entry%%:*}"
        local agent_path="${agent_entry#*:}"
        agent_path="${agent_path/#\~/$HOME}"
        mkdir -p "$agent_path"
        restore_copy "${REMOTE}/05-AI-Agent-Vault/${agent_name}" "$agent_path"
    done
}

# Layer 6: Hardware Blueprint & Fonts
explain_layer_6() {
    echo "     - Preset '${HARDWARE_PRESET}' (fan curves, CPU boost disable service, fonts)"
}
backup_layer_6() {
    local hw_preset_file="${PROJECT_ROOT}/presets/hardware/${HARDWARE_PRESET}.conf"
    if [ "$HARDWARE_PRESET" != "none" ] && [ -f "$hw_preset_file" ]; then
        # shellcheck source=/dev/null
        source "$hw_preset_file"
        for hw_path in "${HARDWARE_PATHS[@]}"; do
            hw_path="${hw_path/#\~/$HOME}"
            if [ -e "$hw_path" ]; then
                local bname
                bname="$(basename "$hw_path")"
                if [ -d "$hw_path" ]; then
                    dumb_sync "$hw_path" "${REMOTE}/06-Hardware-Blueprint/${bname}" \
                        "${TRASH}/06-Hardware-Blueprint/${bname}"
                else
                    dumb_copy "$hw_path" "${REMOTE}/06-Hardware-Blueprint/"
                fi
            fi
        done
    fi
    if [ -d "$HOME/.local/share/fonts/JetBrainsMono" ]; then
        dumb_sync "$HOME/.local/share/fonts/JetBrainsMono" "${REMOTE}/06-Hardware-Blueprint/fonts/JetBrainsMono" \
            "${TRASH}/06-Hardware-Blueprint/fonts/JetBrainsMono"
    fi
}
restore_layer_6() {
    local blueprint_dir="${HARDWARE_BLUEPRINT_DIR:-$HOME/Hardware-Blueprint}"
    mkdir -p "$blueprint_dir" "$HOME/.local/share/fonts/JetBrainsMono"
    restore_copy "${REMOTE}/06-Hardware-Blueprint" "$blueprint_dir"
    restore_copy "${REMOTE}/06-Hardware-Blueprint/fonts/JetBrainsMono" "$HOME/.local/share/fonts/JetBrainsMono"
    if command -v fc-cache &>/dev/null && [ "$IS_DRY_RUN" != "true" ]; then
        fc-cache -fv "$HOME/.local/share/fonts" &>/dev/null || true
    fi
}

# ------------------------------------------------------------------------------
# Generic Layer Dispatchers
# ------------------------------------------------------------------------------
run_layer_backup() {
    local num="$1"
    local name
    name="$(get_layer_name "$num")"
    echo -e "\n${GREEN}[Layer ${num}/${#AVAILABLE_LAYERS[@]}] ${name}...${NC}"
    if declare -f "backup_layer_${num}" >/dev/null; then
        "backup_layer_${num}"
    else
        echo "   Layer handler backup_layer_${num} not found. Skipping."
    fi
}

run_layer_restore() {
    local num="$1"
    local name
    name="$(get_layer_name "$num")"
    echo -e "\n${GREEN}[Restoring Layer ${num}] ${name}...${NC}"
    if declare -f "restore_layer_${num}" >/dev/null; then
        "restore_layer_${num}"
    else
        echo "   Layer handler restore_layer_${num} not found. Skipping."
    fi
}

run_layer_explain() {
    local num="$1"
    local name
    name="$(get_layer_name "$num")"
    echo "   • Layer ${num} (${name}):"
    if declare -f "explain_layer_${num}" >/dev/null; then
        "explain_layer_${num}"
    fi
}

run_explain() {
    print_banner
    local active_engine
    active_engine="$(detect_engine "$REMOTE")"

    echo -e "\n${BOLD}📋 EXACT BREAKDOWN (WHAT, WHERE & HOW):${NC}\n"

    echo -e "${BOLD}1. THE 'WHAT' (What DUMB grabs from your machine):${NC}"
    for entry in "${AVAILABLE_LAYERS[@]}"; do
        local id="${entry%%|*}"
        run_layer_explain "$id"
    done

    echo -e "\n${BOLD}2. THE 'WHERE' (Destination Target):${NC}"
    echo "   • Target: ${REMOTE}"
    if [ "$active_engine" = "rclone" ]; then
        local cloud_acc="${REMOTE%%:*}"
        local cloud_folder="${REMOTE#*:}"
        echo "   • Cloud Provider: ${cloud_acc}"
        echo "   • Target Folder:  ${cloud_folder}"
    else
        echo "   • Target Type:    Local Filesystem / USB Pendrive / Sync Folder"
    fi

    echo -e "\n${BOLD}3. THE 'HOW' (Transport Engine & Security):${NC}"
    echo "   • Active Engine:  ${active_engine}"
    if [ "$active_engine" = "rclone" ]; then
        echo "   • Credentials:    ~/.config/rclone/rclone.conf (Section [${REMOTE%%:*}])"
        echo "   • Safety Net:     ${TRASH} (Move-on-Write)"
    else
        echo "   • Tool:           Native Linux rsync"
        echo "   • Safety Net:     ${TRASH} (Move-on-Write)"
    fi
    echo ""
}

run_status() {
    print_banner
    local active_engine
    active_engine="$(detect_engine "$REMOTE")"
    echo -e "\nConfigured Target: ${REMOTE}"
    echo -e "Storage Engine:    ${active_engine}"
    echo -e "Testing destination access..."
    if [ "$active_engine" = "rclone" ]; then
        if "$RCLONE_CMD" lsd "${REMOTE}" &>/dev/null; then
            echo -e "${GREEN}Status: ONLINE (Cloud)${NC}"
            echo -e "\nActive Layers on Remote:"
            "$RCLONE_CMD" lsf "${REMOTE}"
        else
            echo -e "${RED}Status: OFFLINE or cloud remote unreachable.${NC}"
        fi
    else
        if [ -d "$REMOTE" ]; then
            echo -e "${GREEN}Status: READY (Local directory / Pendrive / Sync folder)${NC}"
            echo -e "\nActive Layers on Target:"
            ls -la "$REMOTE"
        else
            echo -e "${YELLOW}Status: Target directory does not exist yet (will be created on first backup).${NC}"
        fi
    fi
}

run_init() {
    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${BOLD}  🥱 DUMB Workstation Setup Wizard                    ${NC}"
    echo -e "${BLUE}=====================================================${NC}\n"
    echo -e "Let's configure DUMB for your workstation in 4 guided steps.\n"

    # Step 1: Personal Folders
    echo -e "${BOLD}1. Personal Folders to sync (comma-separated):${NC}"
    echo -e "   Default: $HOME/Documents, $HOME/Pictures, $HOME/Projects"
    read -rp "   Add extra paths (or press Enter to keep default): " extra_paths

    # Step 2: Browser Preset
    echo -e "\n${BOLD}2. Which browser do you want to keep persistently logged in?${NC}"
    echo "   [1] Mozilla Firefox (default)"
    echo "   [2] Brave Browser"
    echo "   [3] Google Chrome / Chromium"
    echo "   [4] None (skip browser profile)"
    read -rp "   Choice [1-4, default: 1]: " input_browser
    case "$input_browser" in
        2) BROWSER_CHOICE="brave" ;;
        3) BROWSER_CHOICE="chrome" ;;
        4) BROWSER_CHOICE="none" ;;
        *) BROWSER_CHOICE="firefox" ;;
    esac

    # Step 3: Hardware Preset
    echo -e "\n${BOLD}3. What hardware profile fits this machine?${NC}"
    echo "   [1] ASUS ROG Laptop (fan curves, thermal tuning) (default)"
    echo "   [2] Lenovo ThinkPad (thinkfan, TLP thresholds)"
    echo "   [3] Generic PC / Other Laptop (fonts, systemd user units)"
    echo "   [4] None (skip hardware blueprint)"
    read -rp "   Choice [1-4, default: 1]: " input_hardware
    case "$input_hardware" in
        2) HARDWARE_CHOICE="thinkpad" ;;
        3) HARDWARE_CHOICE="generic" ;;
        4) HARDWARE_CHOICE="none" ;;
        *) HARDWARE_CHOICE="asus-rog" ;;
    esac

    # Step 4: Storage Target (Smart Auto-Detection)
    echo -e "\n${BOLD}4. Where do you want to save your workstation state?${NC}"
    echo "   [1] USB Flash Drive / Pendrive"
    echo "   [2] Local Sync Folder (Nextcloud, Dropbox, or custom folder)"
    echo "   [3] Cloud Storage Account (Google Drive, OneDrive via rclone)"
    read -rp "   Choice [1-3, default: 3]: " input_dest_type

    case "$input_dest_type" in
        1)
            local found_usbs=()
            for media_dir in "/run/media/$USER" "/media/$USER" "/mnt"; do
                if [ -d "$media_dir" ]; then
                    for d in "$media_dir"/*; do
                        [ -d "$d" ] && found_usbs+=("$d")
                    done
                fi
            done

            if [ ${#found_usbs[@]} -gt 0 ]; then
                echo -e "\n   ${GREEN}Detected mounted drives on your system:${NC}"
                local idx=1
                for usb in "${found_usbs[@]}"; do
                    echo "     [$idx] $usb"
                    idx=$((idx + 1))
                done
                read -rp "   Select drive [1-${#found_usbs[@]}] or type custom path: " usb_sel
                if [[ "$usb_sel" =~ ^[0-9]+$ ]] && [ "$usb_sel" -le "${#found_usbs[@]}" ] && [ "$usb_sel" -ge 1 ]; then
                    selected_usb="${found_usbs[$((usb_sel - 1))]}"
                    REMOTE_CHOICE="${selected_usb}/DUMB-Vault"
                else
                    REMOTE_CHOICE="${usb_sel:-/run/media/$USER/PENDRIVE/DUMB-Vault}"
                fi
            else
                read -rp "   Enter USB / Pendrive mount path [e.g. /run/media/$USER/PENDRIVE/DUMB-Vault]: " input_usb
                REMOTE_CHOICE="${input_usb:-/run/media/$USER/PENDRIVE/DUMB-Vault}"
            fi
            ;;
        2)
            local found_syncs=()
            for sf in "$HOME/Nextcloud" "$HOME/Dropbox" "$HOME/MEGAsync" "$HOME/pCloudDrive" "$HOME/SynologyDrive"; do
                [ -d "$sf" ] && found_syncs+=("$sf")
            done

            if [ ${#found_syncs[@]} -gt 0 ]; then
                echo -e "\n   ${GREEN}Detected local cloud sync folders on your system:${NC}"
                local idx=1
                for s in "${found_syncs[@]}"; do
                    echo "     [$idx] $s"
                    idx=$((idx + 1))
                done
                read -rp "   Select folder [1-${#found_syncs[@]}] or type custom path: " sf_sel
                if [[ "$sf_sel" =~ ^[0-9]+$ ]] && [ "$sf_sel" -le "${#found_syncs[@]}" ] && [ "$sf_sel" -ge 1 ]; then
                    selected_sf="${found_syncs[$((sf_sel - 1))]}"
                    REMOTE_CHOICE="${selected_sf}/DUMB-Vault"
                else
                    REMOTE_CHOICE="${sf_sel:-$HOME/Nextcloud/DUMB-Vault}"
                fi
            else
                read -rp "   Enter Sync Folder path [default: $HOME/Nextcloud/DUMB-Vault]: " input_sync
                REMOTE_CHOICE="${input_sync:-$HOME/Nextcloud/DUMB-Vault}"
            fi
            ;;
        *)
            if ! command -v "$RCLONE_CMD" &>/dev/null; then
                echo -e "\n   ${YELLOW}⚠️ rclone is not installed on this system.${NC}"
                echo -e "   To install rclone:"
                echo -e "     • Fedora/Nobara:  sudo dnf install rclone"
                echo -e "     • Arch Linux:     sudo pacman -S rclone"
                echo -e "     • Ubuntu/Debian:  sudo apt install rclone\n"
                read -rp "   Would you rather switch to a local folder/pendrive? [Y/n]: " switch_local
                if [[ ! "$switch_local" =~ ^[Nn] ]]; then
                    REMOTE_CHOICE="$HOME/DUMB-Vault"
                else
                    REMOTE_CHOICE="gdrive:DUMB-Vault"
                fi
            else
                local raw_remotes
                raw_remotes="$("$RCLONE_CMD" listremotes 2>/dev/null || true)"
                local remote_list=()
                while IFS= read -r line; do
                    [ -n "$line" ] && remote_list+=("$line")
                done <<< "$raw_remotes"

                if [ ${#remote_list[@]} -gt 0 ]; then
                    echo -e "\n   ${GREEN}Found cloud accounts configured in your rclone:${NC}"
                    local idx=1
                    for r in "${remote_list[@]}"; do
                        echo "     [$idx] $r"
                        idx=$((idx + 1))
                    done
                    echo "     [C] Configure a new cloud account (runs 'rclone config')"
                    read -rp "   Select account [1-${#remote_list[@]} or C, default: 1]: " r_sel
                    if [[ "$r_sel" =~ ^[Cc] ]]; then
                        "$RCLONE_CMD" config
                        raw_remotes="$("$RCLONE_CMD" listremotes 2>/dev/null || true)"
                    fi
                    if [[ "$r_sel" =~ ^[0-9]+$ ]] && [ "$r_sel" -le "${#remote_list[@]}" ] && [ "$r_sel" -ge 1 ]; then
                        local chosen_remote="${remote_list[$((r_sel - 1))]}"
                        read -rp "   Enter folder name on $chosen_remote [default: DUMB-Vault]: " cloud_f
                        REMOTE_CHOICE="${chosen_remote}${cloud_f:-DUMB-Vault}"
                    else
                        REMOTE_CHOICE="${remote_list[0]}DUMB-Vault"
                    fi
                else
                    echo -e "\n   ${YELLOW}⚠️ No cloud accounts configured in rclone yet.${NC}"
                    read -rp "   Would you like to run 'rclone config' now to connect Google Drive/OneDrive? [y/N]: " do_cfg
                    if [[ "$do_cfg" =~ ^[Yy] ]]; then
                        "$RCLONE_CMD" config
                        raw_remotes="$("$RCLONE_CMD" listremotes 2>/dev/null || true)"
                        REMOTE_CHOICE="gdrive:DUMB-Vault"
                    else
                        echo "   No problem! Setting up local offline backup at ~/DUMB-Vault."
                        REMOTE_CHOICE="$HOME/DUMB-Vault"
                    fi
                fi
            fi
            ;;
    esac

    local pdirs_str="(\n    \"\$HOME/Documents\"\n    \"\$HOME/Pictures\"\n    \"\$HOME/Projects\""
    if [ -n "$extra_paths" ]; then
        IFS=',' read -ra ADDR <<< "$extra_paths"
        for p in "${ADDR[@]}"; do
            trimmed="$(echo "$p" | xargs)"
            if [ -n "$trimmed" ]; then
                pdirs_str+="\n    \"$trimmed\""
            fi
        done
    fi
    pdirs_str+="\n)"

    cat << CFG > "$CONFIG_FILE"
# ==============================================================================
# DUMB — Workstation Configuration
# ==============================================================================

DUMB_REMOTE="${REMOTE_CHOICE}"
DUMB_BROWSER_PRESET="${BROWSER_CHOICE}"
DUMB_HARDWARE_PRESET="${HARDWARE_CHOICE}"

PERSONAL_DIRS=${pdirs_str}

EXCLUDE_PERSONAL=(
    ".git/**"
    "node_modules/**"
    ".venv/**"
    "venv/**"
    "__pycache__/**"
    "target/**"
    "build/**"
    "*.iso"
)

EXCLUDE_CONFIG=(
    "*Cache*/**"
    "*cache*/**"
    "*GPUCache*/**"
    "*Code Cache*/**"
    "*CacheStorage*/**"
    "*blob_storage*/**"
    "mozilla/**"
    "BraveSoftware/**"
    "google-chrome/**"
    "*.lock"
    "*.sock"
    "dconf/user"
)

AI_AGENT_DIRS=(
    "gemini:\$HOME/.gemini/antigravity-cli"
    "claude:\$HOME/.claude"
    "codex:\$HOME/.codex"
    "cursor:\$HOME/.cursor"
    "openclaw:\$HOME/.openclaw"
)

EXCLUDE_AI_AGENTS=(
    "*.log"
    "antigravity-oauth-token"
    ".credentials.json"
    "cache/**"
    "daemon/**"
    "downloads/**"
    "telemetry/**"
)
CFG

    echo -e "\n${GREEN}✅ Configuration saved successfully to:${NC} ${CONFIG_FILE}"
    echo -e "Target set to: ${BOLD}${REMOTE_CHOICE}${NC}"
    echo -e "You can now run: ${BOLD}dumb check${NC} (for dry-run) or ${BOLD}dumb backup${NC} (to sync)!\n"
    exit 0
}

run_bundle() {
    local archive_target="${1:-$HOME/DUMB-Workstation-Backup.tar.zst}"
    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${BOLD}  📦 DUMB Single-Archive Packager                     ${NC}"
    echo -e "${BLUE}  Target: ${archive_target}                            ${NC}"
    echo -e "${BLUE}=====================================================${NC}\n"

    local temp_stage
    temp_stage="$(mktemp -d /tmp/dumb-stage-XXXXXX)"
    echo "1. Staging clean 6-layer workstation to temp directory..."
    DUMB_REMOTE="$temp_stage" run_backup "false" &>/dev/null

    echo "2. Compressing into clean single-file archive: ${archive_target}..."
    if command -v zstd &>/dev/null; then
        tar --zstd -cf "$archive_target" -C "$temp_stage" .
    else
        tar -czf "$archive_target" -C "$temp_stage" .
    fi
    rm -rf "$temp_stage"

    local sz
    sz="$(du -sh "$archive_target" | awk '{print $1}')"
    echo -e "\n${GREEN}✅ Success! Portable pendrive archive created:${NC} ${archive_target} (${sz})"
    echo "You can copy this file to any USB pendrive and restore it anywhere."
    notify_user "DUMB Archive Created" "Saved to ${archive_target} (${sz})"
    exit 0
}

run_unbundle() {
    local archive_file="$1"
    if [ -z "$archive_file" ] || [ ! -f "$archive_file" ]; then
        echo -e "${RED}Error: Please specify a valid archive file. Usage: dumb unbundle <archive.tar.zst>${NC}"
        exit 1
    fi

    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${BOLD}  📦 DUMB Archive Unbundler & Restore                 ${NC}"
    echo -e "${BLUE}  Source: ${archive_file}                             ${NC}"
    echo -e "${BLUE}=====================================================${NC}\n"

    local temp_stage
    temp_stage="$(mktemp -d /tmp/dumb-unstage-XXXXXX)"
    echo "1. Extracting archive..."
    if [[ "$archive_file" =~ \.zst$ ]]; then
        tar --zstd -xf "$archive_file" -C "$temp_stage"
    else
        tar -xzf "$archive_file" -C "$temp_stage"
    fi

    echo "2. Launching selective restore..."
    DUMB_REMOTE="$temp_stage" run_restore ""
    rm -rf "$temp_stage"
    exit 0
}

run_inspect() {
    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${BOLD}  🔍 DUMB Workstation Bloat & Cache Inspector         ${NC}"
    echo -e "${BLUE}=====================================================${NC}\n"
    echo "Scanning your system for disposable cache folders that DUMB strips..."

    local total_bloat=0

    measure_dir() {
        local path="$1"
        local label="$2"
        if [ -d "$path" ]; then
            local sz
            sz=$(du -sm "$path" 2>/dev/null | awk '{print $1}' || echo "0")
            if [ "$sz" -gt 0 ]; then
                echo -e "  • ${label}: ${YELLOW}${sz} MB${NC} (${path})"
                total_bloat=$((total_bloat + sz))
            fi
        fi
    }

    measure_dir "$HOME/.cache/mozilla" "Firefox Web Disk Cache (cache2)"
    measure_dir "$HOME/.cache/BraveSoftware" "Brave Browser Cache"
    measure_dir "$HOME/.cache/google-chrome" "Chrome Browser Cache"
    measure_dir "$HOME/.cache/thumbnails" "Desktop Thumbnail Cache"
    measure_dir "$HOME/.cache/pip" "Python Pip Cache"
    measure_dir "$HOME/.npm" "NPM Package Cache"
    measure_dir "$HOME/.claude/cache" "Claude Code Cache"
    measure_dir "$HOME/.claude/downloads" "Claude Temp Downloads"

    echo -e "\n-----------------------------------------------------"
    if [ "$total_bloat" -gt 1024 ]; then
        local in_gb
        in_gb=$(echo "scale=2; $total_bloat / 1024" | bc 2>/dev/null || echo "$((total_bloat / 1024))")
        echo -e "${BOLD}🎉 Total Disposable Bloat Eliminated: ${GREEN}${in_gb} GB${NC}"
    else
        echo -e "${BOLD}🎉 Total Disposable Bloat Eliminated: ${GREEN}${total_bloat} MB${NC}"
    fi
    echo -e "DUMB prevents all of this from uploading, saving bandwidth and storage.\n"
}

run_backup() {
    local requested_layers="$1"
    local is_dry_run="$2"
    IS_DRY_RUN="$is_dry_run"
    DRY_FLAG=""
    if [ "$IS_DRY_RUN" = "true" ]; then
        DRY_FLAG="--dry-run"
        echo -e "${YELLOW}>>> Running in DRY-RUN mode. No files will be modified or transferred. <<<${NC}\n"
    fi

    local active_engine
    active_engine="$(detect_engine "$REMOTE")"
    if [ "$active_engine" = "rclone" ]; then
        if ! command -v "$RCLONE_CMD" &> /dev/null; then
            echo -e "${RED}Error: Target is a cloud remote, but rclone is not installed.${NC}"
            exit 1
        fi
    else
        if ! command -v "$RSYNC_CMD" &> /dev/null; then
            echo -e "${RED}Error: Target is a local path/pendrive, but rsync is not installed.${NC}"
            exit 1
        fi
    fi

    local layers_to_run=()
    if [ -z "$requested_layers" ] || [[ "$requested_layers" =~ [Aa] ]]; then
        for entry in "${AVAILABLE_LAYERS[@]}"; do
            layers_to_run+=("${entry%%|*}")
        done
    else
        IFS=',' read -ra SPLIT <<< "$requested_layers"
        for l in "${SPLIT[@]}"; do
            layers_to_run+=("$(echo "$l" | xargs)")
        done
    fi

    for l in "${layers_to_run[@]}"; do
        run_layer_backup "$l"
    done

    echo -e "\n${BLUE}=====================================================${NC}"
    if [ "$IS_DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}  🔍 Dry-run check completed! No errors encountered.${NC}"
    else
        echo -e "${GREEN}  ✅ DUMB Backup Completed Successfully!             ${NC}"
        notify_user "DUMB Backup Completed" "Workstation state safely preserved via ${active_engine} to ${REMOTE}"
    fi
    echo -e "${BLUE}=====================================================${NC}\n"
}

run_restore() {
    local requested_layers="$1"
    local is_dry_run="$2"
    IS_DRY_RUN="$is_dry_run"
    local active_engine
    active_engine="$(detect_engine "$REMOTE")"

    echo -e "${BLUE}=====================================================${NC}"
    if [ "$IS_DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}${BOLD}  🔄 DUMB Restore Preview (DRY-RUN MODE)              ${NC}"
    else
        echo -e "${BOLD}  🔄 DUMB Selective Workstation Restore               ${NC}"
    fi
    echo -e "${BLUE}=====================================================${NC}\n"

    if [ -z "$requested_layers" ]; then
        echo "Which layers would you like to restore onto this machine?"
        for entry in "${AVAILABLE_LAYERS[@]}"; do
            local lid="${entry%%|*}"
            local rest="${entry#*|}"
            local lname="${rest%%|*}"
            local ldesc="${rest##*|}"
            echo "  [${lid}] ${lname} (${ldesc})"
        done
        echo "  [A] All Layers"
        read -rp "Select layers to restore [e.g. 1,3,4 or A]: " requested_layers
    fi

    local layers_to_restore=()
    if [[ "$requested_layers" =~ [Aa] ]]; then
        for entry in "${AVAILABLE_LAYERS[@]}"; do
            layers_to_restore+=("${entry%%|*}")
        done
    else
        IFS=',' read -ra SPLIT <<< "$requested_layers"
        for l in "${SPLIT[@]}"; do
            layers_to_restore+=("$(echo "$l" | xargs)")
        done
    fi

    for l in "${layers_to_restore[@]}"; do
        run_layer_restore "$l"
    done

    echo -e "\n${BLUE}=====================================================${NC}"
    if [ "$IS_DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}  🔍 Restore dry-run preview finished! No files were touched.${NC}"
    else
        echo -e "${GREEN}  ✅ Workstation Restore Completed Successfully!      ${NC}"
        notify_user "DUMB Restore Completed" "Selected layers successfully restored onto this system"
    fi
    echo -e "${BLUE}=====================================================${NC}\n"
}

# Parse CLI arguments
cmd="${1:-backup}"
shift || true

TARGET_LAYERS=""
DRY_RUN="false"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--remote)
            REMOTE="$2"
            shift 2
            ;;
        -l|--layers)
            TARGET_LAYERS="$2"
            shift 2
            ;;
        -n|--dry-run)
            DRY_RUN="true"
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            EXTRA_ARG="$1"
            shift
            ;;
    esac
done

case "$cmd" in
    init)
        run_init
        ;;
    backup)
        print_banner
        run_backup "$TARGET_LAYERS" "$DRY_RUN"
        ;;
    bundle)
        run_bundle "$EXTRA_ARG"
        ;;
    unbundle)
        run_unbundle "$EXTRA_ARG"
        ;;
    explain)
        run_explain
        ;;
    restore)
        print_banner
        run_restore "$TARGET_LAYERS" "$DRY_RUN"
        ;;
    inspect)
        run_inspect
        ;;
    check)
        print_banner
        run_backup "$TARGET_LAYERS" "true"
        ;;
    status)
        run_status
        ;;
    version|--version|-v)
        echo "DUMB version ${VERSION}"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo -e "${RED}Unknown command: $cmd${NC}\n"
        usage
        ;;
esac
