#!/usr/bin/env bash
# ==============================================================================
# DUMB — DUMB's Universal Migration & Backup
# A zero-bloat, distro-agnostic workstation migration framework.
# ==============================================================================

set -eo pipefail

VERSION="0.5.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

CONFIG_FILE="${PROJECT_ROOT}/config/layers.conf"
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

REMOTE="${DUMB_REMOTE:-gdrive:Ajaz-Backup-Hub}"
DATE=$(date +%Y-%m-%d)
TRASH="${REMOTE}/Old-Versions/${DATE}"
BROWSER_PRESET="${DUMB_BROWSER_PRESET:-firefox}"
HARDWARE_PRESET="${DUMB_HARDWARE_PRESET:-asus-rog}"

# Detect available engines
RCLONE_CMD="$(command -v rclone 2>/dev/null || echo "$HOME/.local/bin/rclone")"
RSYNC_CMD="$(command -v rsync 2>/dev/null || echo "")"

notify_user() {
    local title="$1"
    local msg="$2"
    if command -v notify-send &>/dev/null; then
        notify-send -a "DUMB" -i dialog-information "$title" "$msg" 2>/dev/null || true
    fi
}

detect_engine() {
    local target="$1"
    if [[ "$target" =~ ^[a-zA-Z0-9_-]+: ]]; then
        echo "rclone"
    else
        echo "rsync"
    fi
}

print_banner() {
    local active_engine
    active_engine="$(detect_engine "$REMOTE")"
    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${BLUE}  🥱 DUMB — DUMB's Universal Migration & Backup     ${NC}"
    echo -e "${BLUE}  Version:   v${VERSION}                                  ${NC}"
    echo -e "${BLUE}  Target:    ${REMOTE}                             ${NC}"
    echo -e "${BLUE}  Engine:    ${active_engine} (Auto-detected)             ${NC}"
    echo -e "${BLUE}  Safety:    ${TRASH}                             ${NC}"
    echo -e "${BLUE}  Browser:   ${BROWSER_PRESET}                    ${NC}"
    echo -e "${BLUE}  Hardware:  ${HARDWARE_PRESET}                   ${NC}"
    echo -e "${BLUE}=====================================================${NC}"
}

usage() {
    echo -e "Usage: dumb [COMMAND] [OPTIONS]\n"
    echo -e "Commands:"
    echo -e "  backup               Run the full 6-layer workstation backup"
    echo -e "  restore [LAYERS]     Restore selected layers to this workstation"
    echo -e "  inspect              Scan and calculate disposable cache bloat eliminated"
    echo -e "  init                 Run interactive setup wizard (Pendrive, Sync Folder, Cloud)"
    echo -e "  check                Dry-run inspection of what would be backed up"
    echo -e "  status               Show current backup configuration and target state"
    echo -e "  version              Print DUMB version"
    echo -e "  help                 Display this help message\n"
    echo -e "Options:"
    echo -e "  -r, --remote <dest>  Override target remote or local path"
    echo -e "  -h, --help           Show help\n"
    echo -e "Target Examples:"
    echo -e "  dumb backup -r /run/media/$USER/PENDRIVE/DUMB-Vault   # USB Flash Drive (rsync)"
    echo -e "  dumb backup -r $HOME/Nextcloud/DUMB-Vault             # Nextcloud / Dropbox (rsync)"
    echo -e "  dumb backup -r gdrive:Ajaz-Backup-Hub                 # Google Drive (rclone)"
    exit 0
}

# Unified Transport Helpers
dumb_sync() {
    local src="$1"
    local dst="$2"
    local trash="$3"
    shift 3
    local excludes=("$@")

    local engine
    engine="$(detect_engine "$dst")"

    if [ "$engine" = "rclone" ]; then
        local exc_args=()
        for exc in "${excludes[@]}"; do
            exc_args+=(--exclude "$exc")
        done
        "$RCLONE_CMD" sync "$src" "$dst" --backup-dir "$trash" "${exc_args[@]}" --fast-list --links $dry_flag
    else
        if [ -z "$RSYNC_CMD" ]; then
            echo -e "${RED}Error: rsync is required for local/pendrive sync but not found.${NC}"
            exit 1
        fi
        mkdir -p "$dst" "$trash"
        local exc_args=()
        for exc in "${excludes[@]}"; do
            exc_args+=(--exclude="$exc")
        done
        local rsync_dry=""
        [ "$dry_flag" = "--dry-run" ] && rsync_dry="-n"
        "$RSYNC_CMD" -a --delete --backup --backup-dir="$trash" "${exc_args[@]}" "$src/" "$dst/" $rsync_dry
    fi
}

dumb_copy() {
    local src="$1"
    local dst="$2"
    local engine
    engine="$(detect_engine "$dst")"

    if [ "$engine" = "rclone" ]; then
        "$RCLONE_CMD" copy "$src" "$dst" $dry_flag
    else
        if [ -z "$RSYNC_CMD" ]; then
            echo -e "${RED}Error: rsync is required for local copying.${NC}"
            exit 1
        fi
        mkdir -p "$dst"
        local rsync_dry=""
        [ "$dry_flag" = "--dry-run" ] && rsync_dry="-n"
        "$RSYNC_CMD" -a "$src" "$dst/" $rsync_dry
    fi
}

run_init() {
    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${BOLD}  🥱 DUMB Workstation Setup Wizard                    ${NC}"
    echo -e "${BLUE}=====================================================${NC}\n"
    echo -e "Let's configure DUMB for your workstation in 4 quick steps.\n"

    # Step 1: Personal Folders
    echo -e "${BOLD}1. Custom Personal Folders to sync (comma-separated):${NC}"
    echo -e "   Default: $HOME/Documents, $HOME/Pictures, $HOME/Projects"
    read -rp "   Add extra paths (or press Enter to keep default): " extra_paths

    # Step 2: Browser Preset
    echo -e "\n${BOLD}2. Which browser do you want to keep persistently logged in?${NC}"
    echo "   [1] Mozilla Firefox (default)"
    echo "   [2] Brave Browser"
    echo "   [3] Google Chrome / Chromium"
    echo "   [4] None (skip browser profile)"
    read -rp "   Choice [1-4, default: 1]: " input_browser
    case "$input_browser" in
        2) BROWSER_CHOICE="brave" ;;
        3) BROWSER_CHOICE="chrome" ;;
        4) BROWSER_CHOICE="none" ;;
        *) BROWSER_CHOICE="firefox" ;;
    esac

    # Step 3: Hardware Preset
    echo -e "\n${BOLD}3. What hardware profile fits this machine?${NC}"
    echo "   [1] ASUS ROG Laptop (fan curves, thermal tuning) (default)"
    echo "   [2] Lenovo ThinkPad (thinkfan, TLP thresholds)"
    echo "   [3] Generic PC / Other Laptop (fonts, systemd user units)"
    echo "   [4] None (skip hardware blueprint)"
    read -rp "   Choice [1-4, default: 1]: " input_hardware
    case "$input_hardware" in
        2) HARDWARE_CHOICE="thinkpad" ;;
        3) HARDWARE_CHOICE="generic" ;;
        4) HARDWARE_CHOICE="none" ;;
        *) HARDWARE_CHOICE="asus-rog" ;;
    esac

    # Step 4: Storage Target (Any Destination)
    echo -e "\n${BOLD}4. Where do you want to save your workstation state?${NC}"
    echo "   [1] USB Pendrive / Flash Drive / External SSD (e.g. /run/media/$USER/Drive/Vault)"
    echo "   [2] Local Sync Folder (e.g. ~/Nextcloud/DUMB-Vault or ~/Dropbox/DUMB-Vault)"
    echo "   [3] Cloud Account via rclone (Google Drive, OneDrive, Proton, S3)"
    read -rp "   Choice [1-3, default: 3]: " input_dest_type

    case "$input_dest_type" in
        1)
            read -rp "   Enter USB / Flash Drive path [e.g. /run/media/$USER/PENDRIVE/DUMB-Vault]: " input_usb
            REMOTE_CHOICE="${input_usb:-/run/media/$USER/PENDRIVE/DUMB-Vault}"
            ;;
        2)
            read -rp "   Enter Sync Folder path [e.g. $HOME/Nextcloud/DUMB-Vault]: " input_sync
            REMOTE_CHOICE="${input_sync:-$HOME/Nextcloud/DUMB-Vault}"
            ;;
        *)
            # Cloud: check if rclone has remotes
            if command -v "$RCLONE_CMD" &>/dev/null; then
                local remotes
                remotes="$("$RCLONE_CMD" listremotes 2>/dev/null || true)"
                if [ -n "$remotes" ]; then
                    echo -e "   Found cloud accounts configured in rclone:"
                    echo "$remotes" | sed 's/^/     • /'
                else
                    echo -e "   ${YELLOW}Note: No rclone cloud remotes found yet. You can run 'rclone config' anytime.${NC}"
                fi
            fi
            read -rp "   Enter Cloud target [default: gdrive:Ajaz-Backup-Hub]: " input_cloud
            REMOTE_CHOICE="${input_cloud:-gdrive:Ajaz-Backup-Hub}"
            ;;
    esac

    local pdirs_str="(\n    \"\$HOME/Documents\"\n    \"\$HOME/Pictures\"\n    \"\$HOME/Projects\""
    if [ -n "$extra_paths" ]; then
        IFS=',' read -ra ADDR <<< "$extra_paths"
        for p in "${ADDR[@]}"; do
            trimmed="$(echo "$p" | xargs)"
            if [ -n "$trimmed" ]; then
                pdirs_str+="\n    \"$trimmed\""
            fi
        done
    fi
    pdirs_str+="\n)"

    cat << CFG > "$CONFIG_FILE"
# ==============================================================================
# DUMB — Workstation Configuration
# ==============================================================================

DUMB_REMOTE="${REMOTE_CHOICE}"
DUMB_BROWSER_PRESET="${BROWSER_CHOICE}"
DUMB_HARDWARE_PRESET="${HARDWARE_CHOICE}"

PERSONAL_DIRS=${pdirs_str}

EXCLUDE_PERSONAL=(
    ".git/**"
    "node_modules/**"
    ".venv/**"
    "venv/**"
    "__pycache__/**"
    "target/**"
    "build/**"
    "*.iso"
)

EXCLUDE_CONFIG=(
    "*Cache*/**"
    "*cache*/**"
    "*GPUCache*/**"
    "*Code Cache*/**"
    "*CacheStorage*/**"
    "*blob_storage*/**"
    "mozilla/**"
    "BraveSoftware/**"
    "google-chrome/**"
    "*.lock"
    "*.sock"
    "dconf/user"
)

AI_AGENT_DIRS=(
    "gemini:\$HOME/.gemini/antigravity-cli"
    "claude:\$HOME/.claude"
    "codex:\$HOME/.codex"
    "cursor:\$HOME/.cursor"
    "openclaw:\$HOME/.openclaw"
)

EXCLUDE_AI_AGENTS=(
    "*.log"
    "antigravity-oauth-token"
    ".credentials.json"
    "cache/**"
    "daemon/**"
    "downloads/**"
    "telemetry/**"
)
CFG

    echo -e "\n${GREEN}✅ Configuration saved successfully to:${NC} ${CONFIG_FILE}"
    echo -e "You can now run: ${BOLD}dumb check${NC} (for dry-run) or ${BOLD}dumb backup${NC} (to sync)!\n"
    exit 0
}

run_inspect() {
    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${BOLD}  🔍 DUMB Workstation Bloat & Cache Inspector         ${NC}"
    echo -e "${BLUE}=====================================================${NC}\n"
    echo "Scanning your system for disposable cache folders that DUMB strips..."

    local total_bloat=0

    measure_dir() {
        local path="$1"
        local label="$2"
        if [ -d "$path" ]; then
            local sz
            sz=$(du -sm "$path" 2>/dev/null | awk '{print $1}' || echo "0")
            if [ "$sz" -gt 0 ]; then
                echo -e "  • ${label}: ${YELLOW}${sz} MB${NC} (${path})"
                total_bloat=$((total_bloat + sz))
            fi
        fi
    }

    measure_dir "$HOME/.cache/mozilla" "Firefox Web Disk Cache (cache2)"
    measure_dir "$HOME/.cache/BraveSoftware" "Brave Browser Cache"
    measure_dir "$HOME/.cache/google-chrome" "Chrome Browser Cache"
    measure_dir "$HOME/.cache/thumbnails" "Desktop Thumbnail Cache"
    measure_dir "$HOME/.cache/pip" "Python Pip Cache"
    measure_dir "$HOME/.npm" "NPM Package Cache"
    measure_dir "$HOME/.claude/cache" "Claude Code Cache"
    measure_dir "$HOME/.claude/downloads" "Claude Temp Downloads"

    echo -e "\n-----------------------------------------------------"
    if [ "$total_bloat" -gt 1024 ]; then
        local in_gb
        in_gb=$(echo "scale=2; $total_bloat / 1024" | bc 2>/dev/null || echo "$((total_bloat / 1024))")
        echo -e "${BOLD}🎉 Total Disposable Bloat Eliminated: ${GREEN}${in_gb} GB${NC}"
    else
        echo -e "${BOLD}🎉 Total Disposable Bloat Eliminated: ${GREEN}${total_bloat} MB${NC}"
    fi
    echo -e "DUMB prevents all of this from uploading, saving bandwidth and storage.\n"
}

run_backup() {
    local is_dry_run="$1"
    local dry_flag=""
    if [ "$is_dry_run" = "true" ]; then
        dry_flag="--dry-run"
        echo -e "${YELLOW}>>> Running in DRY-RUN mode. No files will be modified or transferred. <<<${NC}\n"
    fi

    local active_engine
    active_engine="$(detect_engine "$REMOTE")"
    if [ "$active_engine" = "rclone" ]; then
        if ! command -v "$RCLONE_CMD" &> /dev/null; then
            echo -e "${RED}Error: Target is a cloud remote, but rclone is not installed.${NC}"
            exit 1
        fi
    else
        if ! command -v "$RSYNC_CMD" &> /dev/null; then
            echo -e "${RED}Error: Target is a local path/pendrive, but rsync is not installed.${NC}"
            exit 1
        fi
    fi

    # 1. Personal Files
    echo -e "${GREEN}[Layer 1/6] Personal Files...${NC}"
    for pdir in "${PERSONAL_DIRS[@]}"; do
        eval pdir="$pdir"
        if [ -d "$pdir" ]; then
            local bname
            bname="$(basename "$pdir")"
            echo "   • Syncing: $pdir -> ${REMOTE}/01-Personal-Files/${bname}"
            dumb_sync "$pdir" "${REMOTE}/01-Personal-Files/${bname}" \
                "${TRASH}/01-Personal-Files/${bname}" "${EXCLUDE_PERSONAL[@]}"
        fi
    done

    # 2. Clean dot-config
    echo -e "\n${GREEN}[Layer 2/6] Clean App Configurations (~/.config)...${NC}"
    if [ -d "$HOME/.config" ]; then
        dumb_sync "$HOME/.config" "${REMOTE}/02-dot-config" \
            "${TRASH}/02-dot-config" "${EXCLUDE_CONFIG[@]}"
    fi

    # 3. Browser Session Vault
    echo -e "\n${GREEN}[Layer 3/6] Browser Session Vault (Preset: ${BROWSER_PRESET})...${NC}"
    local browser_preset_file="${PROJECT_ROOT}/presets/browsers/${BROWSER_PRESET}.conf"
    if [ "$BROWSER_PRESET" != "none" ] && [ -f "$browser_preset_file" ]; then
        # shellcheck source=/dev/null
        source "$browser_preset_file"
        local found_browser=""
        for b_path in "${BROWSER_PATHS[@]}"; do
            if [ -d "$b_path" ]; then
                found_browser="$b_path"
                break
            fi
        done
        if [ -n "$found_browser" ]; then
            echo "   • Syncing Browser [${BROWSER_NAME}]: $found_browser"
            dumb_sync "$found_browser" "${REMOTE}/03-Browser-Vault" \
                "${TRASH}/03-Browser-Vault" "${BROWSER_EXCLUDES[@]}"
        else
            echo "   No active profile directory found for ${BROWSER_NAME}. Skipping."
        fi
    else
        echo "   Browser preset set to 'none' or preset file missing. Skipping."
    fi

    # 4. Home Dotfiles & Local Binaries
    echo -e "\n${GREEN}[Layer 4/6] Home Dotfiles & Custom Scripts...${NC}"
    [ -f "$HOME/.bashrc" ] && dumb_copy "$HOME/.bashrc" "${REMOTE}/04-Home-Dotfiles/"
    [ -f "$HOME/.gitconfig" ] && dumb_copy "$HOME/.gitconfig" "${REMOTE}/04-Home-Dotfiles/"
    [ -f "$HOME/.profile" ] && dumb_copy "$HOME/.profile" "${REMOTE}/04-Home-Dotfiles/"
    [ -f "$HOME/.zshrc" ] && dumb_copy "$HOME/.zshrc" "${REMOTE}/04-Home-Dotfiles/"

    if [ -d "$HOME/.local/bin" ]; then
        dumb_sync "$HOME/.local/bin" "${REMOTE}/04-Home-Dotfiles/local-bin" \
            "${TRASH}/04-Home-Dotfiles/local-bin" "agy" "rclone"
    fi

    # 5. AI Agent Vault
    echo -e "\n${GREEN}[Layer 5/6] AI Agent Vault...${NC}"
    for agent_entry in "${AI_AGENT_DIRS[@]}"; do
        local agent_name="${agent_entry%%:*}"
        local agent_path="${agent_entry#*:}"
        eval agent_path="$agent_path"
        if [ -d "$agent_path" ]; then
            echo "   • Syncing AI Agent [${agent_name}]: $agent_path"
            dumb_sync "$agent_path" "${REMOTE}/05-AI-Agent-Vault/${agent_name}" \
                "${TRASH}/05-AI-Agent-Vault/${agent_name}" "${EXCLUDE_AI_AGENTS[@]}"
        fi
    done

    # 6. Hardware Blueprint & Fonts
    echo -e "\n${GREEN}[Layer 6/6] Hardware Blueprint (Preset: ${HARDWARE_PRESET})...${NC}"
    local hw_preset_file="${PROJECT_ROOT}/presets/hardware/${HARDWARE_PRESET}.conf"
    if [ "$HARDWARE_PRESET" != "none" ] && [ -f "$hw_preset_file" ]; then
        # shellcheck source=/dev/null
        source "$hw_preset_file"
        for hw_path in "${HARDWARE_PATHS[@]}"; do
            if [ -e "$hw_path" ]; then
                local bname
                bname="$(basename "$hw_path")"
                if [ -d "$hw_path" ]; then
                    dumb_sync "$hw_path" "${REMOTE}/06-Hardware-Blueprint/${bname}" \
                        "${TRASH}/06-Hardware-Blueprint/${bname}"
                else
                    dumb_copy "$hw_path" "${REMOTE}/06-Hardware-Blueprint/"
                fi
            fi
        done
    fi

    if [ -d "$HOME/.local/share/fonts/JetBrainsMono" ]; then
        dumb_sync "$HOME/.local/share/fonts/JetBrainsMono" "${REMOTE}/06-Hardware-Blueprint/fonts/JetBrainsMono" \
            "${TRASH}/06-Hardware-Blueprint/fonts/JetBrainsMono"
    fi

    echo -e "\n${BLUE}=====================================================${NC}"
    if [ "$is_dry_run" = "true" ]; then
        echo -e "${YELLOW}  🔍 Dry-run check completed! No errors encountered.${NC}"
    else
        echo -e "${GREEN}  ✅ DUMB Backup Completed Successfully!             ${NC}"
        notify_user "DUMB Backup Completed" "Workstation state safely preserved via ${active_engine} to ${REMOTE}"
    fi
    echo -e "${BLUE}=====================================================${NC}\n"
}

run_restore() {
    local requested_layers="$1"
    local active_engine
    active_engine="$(detect_engine "$REMOTE")"

    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${BOLD}  🔄 DUMB Selective Workstation Restore               ${NC}"
    echo -e "${BLUE}=====================================================${NC}\n"

    if [ -z "$requested_layers" ]; then
        echo "Which layers would you like to restore onto this machine?"
        echo "  [1] Personal Files (Documents, Projects, Pictures)"
        echo "  [2] Application Configurations (~/.config)"
        echo "  [3] Browser Session Vault (Persistent Logins / Cookies)"
        echo "  [4] Home Dotfiles & Custom Scripts (~/.bashrc, ~/.local/bin)"
        echo "  [5] AI Agent Vault (Antigravity & Claude memories)"
        echo "  [6] Hardware Blueprint & Fonts (Fan curves, services, fonts)"
        echo "  [A] All Layers"
        read -rp "Select layers to restore [e.g. 1,3,4 or A]: " requested_layers
    fi

    restore_copy() {
        local src="$1"
        local dst="$2"
        if [ "$active_engine" = "rclone" ]; then
            "$RCLONE_CMD" copy "$src" "$dst" --fast-list 2>/dev/null || true
        else
            mkdir -p "$dst"
            "$RSYNC_CMD" -a "$src/" "$dst/" 2>/dev/null || true
        fi
    }

    restore_layer() {
        local layer_num="$1"
        case "$layer_num" in
            1)
                echo -e "\n${GREEN}[Restoring Layer 1] Personal Files...${NC}"
                restore_copy "${REMOTE}/01-Personal-Files/Documents" "$HOME/Documents"
                restore_copy "${REMOTE}/01-Personal-Files/Pictures" "$HOME/Pictures"
                restore_copy "${REMOTE}/01-Personal-Files/Projects" "$HOME/Projects"
                ;;
            2)
                echo -e "\n${GREEN}[Restoring Layer 2] Application Configurations...${NC}"
                restore_copy "${REMOTE}/02-dot-config" "$HOME/.config"
                ;;
            3)
                echo -e "\n${GREEN}[Restoring Layer 3] Browser Session Vault...${NC}"
                local browser_preset_file="${PROJECT_ROOT}/presets/browsers/${BROWSER_PRESET}.conf"
                if [ -f "$browser_preset_file" ]; then
                    source "$browser_preset_file"
                    local dest_path="${BROWSER_PATHS[0]}"
                    mkdir -p "$dest_path"
                    restore_copy "${REMOTE}/03-Browser-Vault" "$dest_path"
                    echo "   Logins and cookies restored to: $dest_path"
                fi
                ;;
            4)
                echo -e "\n${GREEN}[Restoring Layer 4] Dotfiles & Local Scripts...${NC}"
                restore_copy "${REMOTE}/04-Home-Dotfiles/.bashrc" "$HOME/.bashrc"
                restore_copy "${REMOTE}/04-Home-Dotfiles/.gitconfig" "$HOME/.gitconfig"
                restore_copy "${REMOTE}/04-Home-Dotfiles/.profile" "$HOME/.profile"
                mkdir -p "$HOME/.local/bin"
                restore_copy "${REMOTE}/04-Home-Dotfiles/local-bin" "$HOME/.local/bin"
                ;;
            5)
                echo -e "\n${GREEN}[Restoring Layer 5] AI Agent Vault...${NC}"
                mkdir -p "$HOME/.gemini/antigravity-cli" "$HOME/.claude"
                restore_copy "${REMOTE}/05-AI-Agent-Vault/gemini" "$HOME/.gemini/antigravity-cli"
                restore_copy "${REMOTE}/05-AI-Agent-Vault/claude" "$HOME/.claude"
                ;;
            6)
                echo -e "\n${GREEN}[Restoring Layer 6] Hardware Blueprint & Fonts...${NC}"
                mkdir -p "$HOME/Nobara-Blueprint" "$HOME/.local/share/fonts/JetBrainsMono"
                restore_copy "${REMOTE}/06-Hardware-Blueprint" "$HOME/Nobara-Blueprint"
                restore_copy "${REMOTE}/06-Hardware-Blueprint/fonts/JetBrainsMono" "$HOME/.local/share/fonts/JetBrainsMono"
                if command -v fc-cache &>/dev/null; then
                    fc-cache -fv "$HOME/.local/share/fonts" &>/dev/null || true
                fi
                ;;
        esac
    }

    if [[ "$requested_layers" =~ [Aa] ]]; then
        for l in 1 2 3 4 5 6; do restore_layer "$l"; done
    else
        IFS=',' read -ra LAYERS <<< "$requested_layers"
        for l in "${LAYERS[@]}"; do
            trimmed="$(echo "$l" | xargs)"
            restore_layer "$trimmed"
        done
    fi

    echo -e "\n${BLUE}=====================================================${NC}"
    echo -e "${GREEN}  ✅ Workstation Restore Completed Successfully!      ${NC}"
    echo -e "${BLUE}=====================================================${NC}\n"
    notify_user "DUMB Restore Completed" "Selected layers successfully restored onto this system"
}

# Parse CLI arguments
cmd="${1:-backup}"
shift || true

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--remote)
            REMOTE="$2"
            shift 2
            ;;
        --layers)
            RESTORE_LAYERS="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            shift
            ;;
    esac
done

case "$cmd" in
    init)
        run_init
        ;;
    backup)
        print_banner
        run_backup "false"
        ;;
    restore)
        print_banner
        run_restore "$RESTORE_LAYERS"
        ;;
    inspect)
        run_inspect
        ;;
    check)
        print_banner
        run_backup "true"
        ;;
    status)
        print_banner
        local active_engine
        active_engine="$(detect_engine "$REMOTE")"
        echo -e "\nConfigured Target: ${REMOTE}"
        echo -e "Storage Engine:    ${active_engine}"
        echo -e "Testing destination access..."
        if [ "$active_engine" = "rclone" ]; then
            if "$RCLONE_CMD" lsd "${REMOTE}" &>/dev/null; then
                echo -e "${GREEN}Status: ONLINE (Cloud)${NC}"
                echo -e "\nActive Layers on Remote:"
                "$RCLONE_CMD" lsf "${REMOTE}"
            else
                echo -e "${RED}Status: OFFLINE or cloud remote unreachable.${NC}"
            fi
        else
            if [ -d "$REMOTE" ]; then
                echo -e "${GREEN}Status: READY (Local directory / Pendrive / Sync folder)${NC}"
                echo -e "\nActive Layers on Target:"
                ls -la "$REMOTE"
            else
                echo -e "${YELLOW}Status: Target directory does not exist yet (will be created on first backup).${NC}"
            fi
        fi
        ;;
    version|--version|-v)
        echo "DUMB version ${VERSION}"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo -e "${RED}Unknown command: $cmd${NC}\n"
        usage
        ;;
esac
